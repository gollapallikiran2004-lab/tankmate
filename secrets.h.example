// secrets.h.example
// Copy this file to secrets.h and fill in your real values.
// NEVER commit secrets.h to git — it is in .gitignore

#pragma once

// Firebase Realtime Database
#define FIREBASE_URL    "https://your-project-default-rtdb.region.firebasedatabase.app"
#define FIREBASE_SECRET "your_firebase_database_secret_here"

// Device pairing salt — must match on both Tank Unit and Motor Unit
#define DEVICE_SECRET_SALT "YOUR_UNIQUE_SALT_HERE"

// Motor Unit MAC address — update to your Motor Unit ESP32 MAC
// Format: {0xXX, 0xXX, 0xXX, 0xXX, 0xXX, 0xXX}
// Find MAC by flashing Motor Unit and reading Serial Monitor at startup
uint8_t MOTOR_MAC[] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
